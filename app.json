{
  "expo": {
    "name": "Howl",
    "slug": "howl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/howl-app-icon.png",
    "scheme": "howl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roshaniayu.howl"
    },
    "android": {
      "package": "com.roshaniayu.howl",
      "adaptiveIcon": {
        "backgroundColor": "#0F1E2B",
        "foregroundImage": "./assets/howl-app-icon.png",
        "backgroundImage": "./assets/howl-app-icon.png",
        "monochromeImage": "./assets/howl-app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/howl-app-icon.png"
    },
    "splash": {
      "image": "./assets/logo/howl-logo-with-text.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1E2B"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/howl-logo-with-text.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1E2B",
          "dark": {
            "backgroundColor": "#0F1E2B"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f356dabb-6922-4213-9a7c-a8abd8bd4007"
      }
    }
  }
}